{
  "name": "discord",
  "version": "1.0.0",
  "main": "build/app.js",
  "license": "MIT",
  "scripts": {
    "start": "node .",
    "build": "ts-node --files config/deleteBuild.ts && tsc --project tsconfig.json && vite build",
    "prod": "npm run build && npm run start",
    "dev": "cross-env NODE_ENV=dev npm run prod",
    "dev:watch": "cross-env NODE_ENV=dev nodemon --watch 'src/core/**/*' --watch 'src/app.ts' -e ts,tsx --exec 'ts-node --files src/app.ts'",
    "lint": "eslint \"{src,apps,libs,test}/**/*.{ts,vue}\" --fix"
  },
  "_moduleAliases": {
    "@": "./build"
  },
  "dependencies": {
    "@popperjs/core": "^2.11.8",
    "@vueuse/core": "^11.0.3",
    "bcrypt": "^5.1.1",
    "bootstrap": "^5.3.3",
    "jsonwebtoken": "^9.0.2",
    "mime-types": "^2.1.35",
    "mkdirp": "^3.0.1",
    "pinia": "^2.2.2",
    "socket.io": "^4.7.5",
    "uuid": "^10.0.0",
    "vue": "^3.5.5",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.1.0",
    "@eslint/js": "^9.10.0",
    "@types/bcrypt": "^5.0.2",
    "@types/dotenv-safe": "^8.1.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/mime-types": "^2.1.4",
    "@types/mkdirp": "^2.0.0",
    "@types/node": "^22.5.5",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "8.5.0",
    "@typescript-eslint/parser": "8.5.0",
    "@vitejs/plugin-vue": "^5.1.3",
    "@vitejs/plugin-vue-jsx": "^4.0.1",
    "@vue/compiler-sfc": "^3.5.5",
    "cross-env": "^7.0.3",
    "dotenv-safe": "^9.1.0",
    "eslint": "^9.10.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-vue": "^9.28.0",
    "module-alias": "^2.2.3",
    "nodemon": "^3.1.4",
    "pnpm": "^9.10.0",
    "prettier": "^3.3.3",
    "sass": "^1.78.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "types-tsconfig": "^2.1.1",
    "typescript": "5.5.4",
    "vite": "^5.4.5"
  }
}
